generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Shop {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String?
  shopId                 String   @unique
  installationStatus     String?
  apiKey                 String?
  scope                  String?
  lastGetPermissionRetry DateTime?
}
